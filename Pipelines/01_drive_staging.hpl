      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Filter rows 2 2</from>
      <to>data_error 2 2</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Filter rows 2 2</from>
      <to>data_clean orders</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
